#version 310 es

// =============================================================================
//  voronoi_terrain.vert — воронои-террейн + событийное дрожание «желе».
// =============================================================================
//  Как terrain.vert (V инвертирован под кастомные шейдеры), плюс нормаль грани
//  для flat-освещения. Нод чанка только сдвигается (без поворота), поэтому
//  нормаль в пространстве меша == мировая нормаль.
//
//  Желейное дрожание — СОБЫТИЙНОЕ (в отличие от непрерывных волн воды):
//  террейн биома неподвижен, а отдельные кубики время от времени «вздрагивают»
//  затухающей синусоидой и замирают. Расписание вспышек — детерминированный
//  хэш узла решётки (целые мировые координаты): псевдослучайные фаза, период,
//  амплитуда и направление + случайный пропуск циклов. В среднем одновременно
//  активна ~1/5 кубиков поверхности (настраивается JW_FIRE_P/JW_PERIOD).
//
//  Бесшовность: вершина находит свой узел через round(u_chunkOrigin + local),
//  т.е. смещение — функция ТОЛЬКО мировой позиции. Общие углы соседних кубов
//  (и чанков) получают одинаковое смещение → трещин нет. Углы одного кубика
//  дрожат независимо — кубик заметно «перекашивает», что и даёт ощущение желе.
//
//  Сила дрожания запечена мешером в a_texCoord1.x (маска softness·surf — та же,
//  что у статической CPU-деформации: трясётся ровно то, что «оплывает», а на
//  границах с обычными биомами маска сходит на ноль). В a_texCoord1.y — нагрузка:
//  под толщей блоков вспышки слабее.
//
//  Атрибуты (интерливинг из VoronoiMeshBuilder::vertexAttribs):
//    POSITION  = a_position  (vec3, локальные коорд. чанка)
//    NORMAL    = a_normal    (vec3, нормаль грани после CPU-деформации)
//    TEXCOORD0 = a_texCoord  (vec2, UV атласа)
//    TEXCOORD1 = a_texCoord1 (vec2, x: маска дрожания [0..1], y: нагрузка [0..1])
//  Имя a_texCoord1 обязательно: axmol биндит атрибуты меша по имени.
// =============================================================================

layout(location = POSITION)  in vec4 a_position;
layout(location = TEXCOORD0) in vec2 a_texCoord;
layout(location = TEXCOORD1) in vec2 a_texCoord1;
layout(location = NORMAL)    in vec3 a_normal;

layout(location = TEXCOORD0) out vec2 v_texCoord;
layout(location = 1)         out vec3 v_normal;

layout(std140) uniform vs_ub {
    mat4  u_MVPMatrix;    // авто-биндинг движком (Pass::updateMVPUniform)
    vec3  u_chunkOrigin;  // мировые координаты угла чанка (задаётся при создании нода)
    float u_time;         // время в секундах (обновляется каждый кадр из GameScene)
};

// -----------------------------------------------------------------------------
//  Параметры событийной модели дрожания.
//  Доля одновременно активных УЗЛОВ ≈ JW_FIRE_P · JW_DURATION / JW_PERIOD
//  (по умолчанию ~5 %; у поверхностного кубика 4–8 видимых углов, поэтому
//  шевелится примерно каждый 4–5-й кубик — как раз «один из пяти»).
// -----------------------------------------------------------------------------
const float JW_PERIOD   = 6.0;   // средний период цикла событий на узел (с)
const float JW_DURATION = 1.6;   // длительность затухающей вспышки (с)
const float JW_FIRE_P   = 0.18;  // вероятность вспышки в цикле: ↑ — кубики двигаются чаще
const float JW_AMP      = 0.14;  // пиковая амплитуда вспышки (блоков)
const float JW_DECAY    = 2.2;   // скорость затухания (1/с)
const float JW_OMEGA    = 8.0;   // частота качков внутри вспышки (рад/с) ≈ 2 полных колебания

// PCG3D: детерминированный хэш ivec3 → 3 псевдослучайных uint (без состояния).
uvec3 pcg3d(uvec3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}

// Хэш узла с «солью» (номер параметра / номер цикла) → 3 float в [0,1].
vec3 hash3f(ivec3 node, uint salt)
{
    uvec3 h = pcg3d(uvec3(node) + uvec3(salt * 0x85EBCA6Bu, salt * 0xC2B2AE35u, salt * 0x27D4EB2Fu));
    return vec3(h) * (1.0 / 4294967295.0);
}

// Смещение и косметический наклон нормали для одного узла в момент t.
void jellyImpulse(ivec3 node, float t, out vec3 disp, out vec3 tilt)
{
    disp = vec3(0.0);
    tilt = vec3(0.0);

    vec3 r0   = hash3f(node, 0u);                    // фаза / джиттер периода / джиттер амплитуды
    float T   = JW_PERIOD * (0.75 + 0.5 * r0.y);     // персональный период узла (4.5–7.5 с)
    float tt  = t + r0.x * T;                        // сдвиг фазы — узлы не синхронны
    float cyc = floor(tt / T);                       // номер текущего цикла
    float a   = tt - cyc * T;                        // время от начала цикла
    if (a >= JW_DURATION)
        return;                                      // большую часть цикла узел неподвижен

    // Случайный пропуск циклов: вспышки идут вразнобой, а не метрономом
    if (hash3f(node, uint(mod(cyc, 1024.0)) + 1u).x > JW_FIRE_P)
        return;

    // Затухающая синусоида с нулевыми краями: плавный старт (sin(0)=0),
    // гарантированный ноль в конце (линейное окно).
    float env = exp(-JW_DECAY * a) * sin(JW_OMEGA * a) * (1.0 - a / JW_DURATION);

    vec3 dir = hash3f(node, 2u) * 2.0 - 1.0;         // случайное направление рывка
    dir.y   += 0.35;                                 // лёгкий сдвиг вверх — «подброс»
    disp = normalize(dir) * (JW_AMP * (0.6 + 0.8 * r0.z) * env);

    tilt = (hash3f(node, 3u) * 2.0 - 1.0) * (0.35 * env);  // «игра» освещения при вспышке
}

void main(void)
{
    vec3 localPos = a_position.xyz;
    vec3 n        = a_normal;

    float mask = a_texCoord1.x;
    if (mask > 0.0)
    {
        // Под нагрузкой желе «тяжелеет»: вспышки затухают до ~65 %
        float damp = (1.0 - 0.35 * clamp(a_texCoord1.y, 0.0, 1.0)) * mask;

        // Узел решётки этой вершины: round по МИРОВЫМ координатам — статический
        // сдвиг от «оплывания» (≤ ~0.16 блока) не сбивает привязку к узлу.
        ivec3 node = ivec3(floor(localPos + u_chunkOrigin + 0.5));

        vec3 disp, tilt;
        jellyImpulse(node, u_time, disp, tilt);
        localPos += disp * damp;
        n        = normalize(n + tilt * damp);
    }

    v_texCoord  = vec2(a_texCoord.x, 1.0 - a_texCoord.y);
    v_normal    = n;
    gl_Position = u_MVPMatrix * vec4(localPos, 1.0);
}
